# Do not list folder contents when no index file exists.
Options -Indexes

# The homepage is PHP so testimonials and the portfolio can load from the database.
DirectoryIndex index.php

# Block hidden files (.git, .env, .htaccess) when requested directly.
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# Block secrets, archives, logs, and dependency metadata.
<FilesMatch "(?i)^(composer\.(json|lock)|error_log|wp-config\.php|database\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "(?i)\.(sql|zip|log|ini|bak|env|md|yml|yaml|sh|dist)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# Private folders. PHP include/require still works; only browser requests are blocked.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^index\.html$ index.php [L,QSA]
    RewriteRule ^(\.git|setup|includes|config|vendor)(/|$) - [F,L]
</IfModule>

# Skip CSP on WordPress, which needs eval and third-party hosts.
<IfModule mod_setenvif.c>
    SetEnvIf Request_URI "(wp-admin|wp-includes|wp-content|wp-login\.php)" no_csp
</IfModule>

<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob:; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; media-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" env=!no_csp
    Header always set Permissions-Policy "accelerometer=(), autoplay=(self), camera=(), display-capture=(), encrypted-media=(self), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(self), publickey-credentials-get=(), usb=(), xr-spatial-tracking=()"
</IfModule>
